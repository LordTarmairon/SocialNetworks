# ===========================================================================
# .gitignore raíz — red de seguridad para todo el monorepo.
# Cada app (Backend/, Frontend/...) tiene además su propio .gitignore.
# ===========================================================================

# Dependencias
node_modules/

# Variables de entorno y secretos (NUNCA subir)
.env
.env.*
!.env.example
*.pem
*.key

# Compilados / builds
dist/
build/
out/

# Cliente Prisma generado
**/generated/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Caché
.cache/
.turbo/
.eslintcache
*.tsbuildinfo

# Editores / IDE
.vscode/
.idea/
*.swp
*.swo

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini
