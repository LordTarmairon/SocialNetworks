# Normaliza finales de línea: LF en el repositorio para todo el texto.
* text=auto eol=lf

# Scripts de Windows que requieren CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Archivos binarios (no tocar finales de línea).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary
