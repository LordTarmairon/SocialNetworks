// Esquema de Prisma — modelo de datos compartido por ambas apps.
// Prisma 7: las URLs de conexión se definen en prisma.config.ts, no aquí.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Usuario: base común para la app de chat (WhatsApp) y la red social (Tuenti).
// ---------------------------------------------------------------------------
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  displayName  String
  passwordHash String
  avatarUrl    String?
  bio          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Presencia.
  lastSeenAt DateTime?

  // Privacidad (estilo WhatsApp): si se desactivan, ni se comparte ni se ve.
  showReadReceipts Boolean @default(true)
  showLastSeen     Boolean @default(true)

  // Relaciones de amistad (dos lados de la misma tabla Friendship).
  sentRequests     Friendship[] @relation("SentRequests")
  receivedRequests Friendship[] @relation("ReceivedRequests")

  // Mensajería.
  conversations ConversationParticipant[]
  messages      Message[]

  // Red social (estilo Tuenti).
  posts    Post[]
  comments Comment[]
  likes    Like[]
  stories  Story[]

  // Novedades: visitas a perfil y notificaciones.
  viewsMade     ProfileView[]  @relation("ViewsMade")
  viewsReceived ProfileView[]  @relation("ViewsReceived")
  notifications Notification[] @relation("NotificationsReceived")
  actions       Notification[] @relation("NotificationsActed")

  @@map("users")
}

// ---------------------------------------------------------------------------
// Amistad / contacto entre dos usuarios.
// status: "PENDING" (solicitud enviada) | "ACCEPTED" (ya son amigos).
// Una fila representa la relación; el "requester" la inició.
// ---------------------------------------------------------------------------
model Friendship {
  id          String   @id @default(uuid())
  requesterId String
  addresseeId String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester User @relation("SentRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("ReceivedRequests", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
  @@map("friendships")
}

// ---------------------------------------------------------------------------
// Conversación (1-a-1 por ahora; el modelo soporta grupos en el futuro).
// ---------------------------------------------------------------------------
model Conversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String   @id @default(uuid())
  conversationId String
  userId         String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  attachmentUrl  String?
  createdAt      DateTime  @default(now())
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ===========================================================================
// Red social estilo Tuenti: publicaciones (muro/feed), comentarios, "me gusta"
// y stories efímeras.
// ===========================================================================
model Post {
  id        String   @id @default(uuid())
  authorId  String
  content   String
  imageUrl  String?
  createdAt DateTime @default(now())

  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]
  likes    Like[]

  @@index([authorId, createdAt])
  @@map("posts")
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("comments")
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("likes")
}

model Story {
  id        String   @id @default(uuid())
  authorId  String
  imageUrl  String
  createdAt DateTime @default(now())
  expiresAt DateTime

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@map("stories")
}

// ---------------------------------------------------------------------------
// Visitas a perfil (una fila por visitante; se actualiza la fecha).
// ---------------------------------------------------------------------------
model ProfileView {
  id        String   @id @default(uuid())
  viewerId  String
  profileId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  viewer  User @relation("ViewsMade", fields: [viewerId], references: [id], onDelete: Cascade)
  profile User @relation("ViewsReceived", fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([viewerId, profileId])
  @@index([profileId])
  @@map("profile_views")
}

// ---------------------------------------------------------------------------
// Notificaciones para el panel de "Novedades".
// type: like | comment | friend_request | friend_accept
// ---------------------------------------------------------------------------
model Notification {
  id        String   @id @default(uuid())
  userId    String
  actorId   String
  type      String
  postId    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User @relation("NotificationsReceived", fields: [userId], references: [id], onDelete: Cascade)
  actor User @relation("NotificationsActed", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}
