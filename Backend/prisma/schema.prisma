// Esquema de Prisma — modelo de datos compartido por ambas apps.
// Prisma 7: las URLs de conexión se definen en prisma.config.ts, no aquí.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Usuario: base común para la app de chat (WhatsApp) y la red social (Tuenti).
// ---------------------------------------------------------------------------
model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  phone        String?  @unique
  username     String   @unique
  displayName  String
  passwordHash String
  avatarUrl    String?
  coverUrl     String?
  bio          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Presencia.
  lastSeenAt DateTime?

  // Privacidad (estilo WhatsApp): si se desactivan, ni se comparte ni se ve.
  showReadReceipts Boolean @default(true)
  showLastSeen     Boolean @default(true)

  // Relaciones de amistad (dos lados de la misma tabla Friendship).
  sentRequests     Friendship[] @relation("SentRequests")
  receivedRequests Friendship[] @relation("ReceivedRequests")

  // Mensajería.
  conversations    ConversationParticipant[]
  messages         Message[]
  messageReactions MessageReaction[]         @relation("MessageReactions")

  // Red social (estilo Tuenti).
  posts        Post[]
  comments     Comment[]
  likes        Like[]
  commentLikes CommentLike[] @relation("CommentLikes")
  savedPosts   SavedPost[]   @relation("SavedPosts")
  stories      Story[]

  // Novedades: visitas a perfil y notificaciones.
  viewsMade     ProfileView[]  @relation("ViewsMade")
  viewsReceived ProfileView[]  @relation("ViewsReceived")
  notifications Notification[] @relation("NotificationsReceived")
  actions       Notification[] @relation("NotificationsActed")

  // Eventos.
  eventsHosted Event[]      @relation("EventsHosted")
  attendances  Attendance[] @relation("Attendances")

  // Fotos y álbumes.
  albums        Album[]        @relation("AlbumsOwned")
  photos        Photo[]        @relation("PhotosOwned")
  photoTags     PhotoTag[]     @relation("PhotoTags")
  photoComments PhotoComment[] @relation("PhotoComments")

  // Bloqueos.
  blocking  Block[] @relation("Blocking")
  blockedBy Block[] @relation("BlockedBy")

  // Historias: vistas, reacciones y respuestas privadas.
  storyViews     StoryView[]     @relation("StoryViews")
  storyReactions StoryReaction[] @relation("StoryReactions")
  storyComments  StoryComment[]  @relation("StoryComments")

  // Seguir (follow), independiente de la amistad.
  following Follow[] @relation("Following")
  followers Follow[] @relation("Followers")

  @@map("users")
}

// Seguimiento unidireccional de un usuario a otro.
model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

// Bloqueo de un usuario a otro.
model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocking", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

// ---------------------------------------------------------------------------
// Amistad / contacto entre dos usuarios.
// status: "PENDING" (solicitud enviada) | "ACCEPTED" (ya son amigos).
// Una fila representa la relación; el "requester" la inició.
// ---------------------------------------------------------------------------
model Friendship {
  id          String   @id @default(uuid())
  requesterId String
  addresseeId String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester User @relation("SentRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("ReceivedRequests", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
  @@map("friendships")
}

// ---------------------------------------------------------------------------
// Conversación: 1-a-1 o grupo (isGroup + name/imageUrl/creatorId).
// ---------------------------------------------------------------------------
model Conversation {
  id        String   @id @default(uuid())
  isGroup   Boolean  @default(false)
  name      String?
  imageUrl  String?
  creatorId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String   @id @default(uuid())
  conversationId String
  userId         String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  attachmentUrl  String?
  attachmentType String?   @default("image") // image | audio
  replyToId      String?
  editedAt       DateTime?
  deleted        Boolean   @default(false)
  forwarded      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  readAt         DateTime?

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?          @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]         @relation("MessageReplies")
  reactions    MessageReaction[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

// Reacción a un mensaje (un emoji por usuario y mensaje, estilo Messenger).
model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation("MessageReactions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@map("message_reactions")
}

// ===========================================================================
// Red social estilo Tuenti: publicaciones (muro/feed), comentarios, "me gusta"
// y stories efímeras.
// ===========================================================================
model Post {
  id           String   @id @default(uuid())
  authorId     String
  content      String
  imageUrl     String?
  videoUrl     String? // si es un reel (vídeo corto)
  visibility   String   @default("friends") // public | friends | private
  sharedPostId String? // si es una publicación compartida
  createdAt    DateTime @default(now())

  author     User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments   Comment[]
  likes      Like[]
  saves      SavedPost[]
  sharedPost Post?       @relation("PostShares", fields: [sharedPostId], references: [id], onDelete: SetNull)
  shares     Post[]      @relation("PostShares")

  @@index([authorId, createdAt])
  @@map("posts")
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  content   String
  parentId  String? // respuesta a otro comentario
  createdAt DateTime @default(now())

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[]     @relation("CommentReplies")
  likes   CommentLike[]

  @@index([postId, createdAt])
  @@map("comments")
}

// "Me gusta" en un comentario.
model CommentLike {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation("CommentLikes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("comment_likes")
}

// Publicación guardada (marcador) por un usuario.
model SavedPost {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation("SavedPosts", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@map("saved_posts")
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  type      String   @default("like") // like | love | haha | wow | sad | angry
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("likes")
}

model Story {
  id        String   @id @default(uuid())
  authorId  String
  imageUrl  String
  createdAt DateTime @default(now())
  expiresAt DateTime

  author    User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  views     StoryView[]
  reactions StoryReaction[]
  comments  StoryComment[]

  @@index([authorId])
  @@map("stories")
}

// Respuesta privada a una historia (solo la ve el autor de la historia).
model StoryComment {
  id        String   @id @default(uuid())
  storyId   String
  userId    String
  content   String
  createdAt DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation("StoryComments", fields: [userId], references: [id], onDelete: Cascade)

  @@index([storyId])
  @@map("story_comments")
}

model StoryView {
  id        String   @id @default(uuid())
  storyId   String
  viewerId  String
  createdAt DateTime @default(now())

  story  Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer User  @relation("StoryViews", fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([storyId, viewerId])
  @@index([storyId])
  @@map("story_views")
}

model StoryReaction {
  id        String   @id @default(uuid())
  storyId   String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation("StoryReactions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@index([storyId])
  @@map("story_reactions")
}

// ---------------------------------------------------------------------------
// Visitas a perfil (una fila por visitante; se actualiza la fecha).
// ---------------------------------------------------------------------------
model ProfileView {
  id        String   @id @default(uuid())
  viewerId  String
  profileId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  viewer  User @relation("ViewsMade", fields: [viewerId], references: [id], onDelete: Cascade)
  profile User @relation("ViewsReceived", fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([viewerId, profileId])
  @@index([profileId])
  @@map("profile_views")
}

// ---------------------------------------------------------------------------
// Notificaciones para el panel de "Novedades".
// type: like | comment | friend_request | friend_accept
// ---------------------------------------------------------------------------
model Notification {
  id        String   @id @default(uuid())
  userId    String
  actorId   String
  type      String
  postId    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User @relation("NotificationsReceived", fields: [userId], references: [id], onDelete: Cascade)
  actor User @relation("NotificationsActed", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Eventos (estilo Tuenti): un anfitrión crea un evento y la gente confirma.
// ---------------------------------------------------------------------------
model Event {
  id          String   @id @default(uuid())
  hostId      String
  title       String
  description String?
  location    String?
  imageUrl    String?
  startsAt    DateTime
  createdAt   DateTime @default(now())

  host        User         @relation("EventsHosted", fields: [hostId], references: [id], onDelete: Cascade)
  attendances Attendance[]

  @@index([startsAt])
  @@map("events")
}

model Attendance {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  status    String   @default("going") // going | maybe | declined
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation("Attendances", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("attendances")
}

// ===========================================================================
// Fotos, álbumes y etiquetas (estilo Facebook).
// ===========================================================================
model Album {
  id          String   @id @default(uuid())
  ownerId     String
  title       String
  description String?
  createdAt   DateTime @default(now())

  owner  User    @relation("AlbumsOwned", fields: [ownerId], references: [id], onDelete: Cascade)
  photos Photo[]

  @@index([ownerId])
  @@map("albums")
}

model Photo {
  id        String   @id @default(uuid())
  albumId   String?
  ownerId   String
  url       String
  caption   String?
  createdAt DateTime @default(now())

  album    Album?         @relation(fields: [albumId], references: [id], onDelete: Cascade)
  owner    User           @relation("PhotosOwned", fields: [ownerId], references: [id], onDelete: Cascade)
  tags     PhotoTag[]
  comments PhotoComment[]

  @@index([albumId])
  @@map("photos")
}

// Etiqueta de una persona en una foto, con su posición (x,y en %).
model PhotoTag {
  id        String   @id @default(uuid())
  photoId   String
  userId    String // persona etiquetada
  taggerId  String // quién etiquetó
  x         Float? // 0-100
  y         Float? // 0-100
  createdAt DateTime @default(now())

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  user  User  @relation("PhotoTags", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([photoId, userId])
  @@index([photoId])
  @@map("photo_tags")
}

// Comentario en una foto.
model PhotoComment {
  id        String   @id @default(uuid())
  photoId   String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  photo  Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  author User  @relation("PhotoComments", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([photoId, createdAt])
  @@map("photo_comments")
}
