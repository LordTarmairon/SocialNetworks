// Esquema de Prisma — modelo de datos compartido por ambas apps.
// Prisma 7: las URLs de conexión se definen en prisma.config.ts, no aquí.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Usuario: base común para la app de chat (WhatsApp) y la red social (Tuenti).
// ---------------------------------------------------------------------------
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  displayName  String
  passwordHash String
  avatarUrl    String?
  bio          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Presencia.
  lastSeenAt DateTime?

  // Privacidad (estilo WhatsApp): si se desactivan, ni se comparte ni se ve.
  showReadReceipts Boolean @default(true)
  showLastSeen     Boolean @default(true)

  // Relaciones de amistad (dos lados de la misma tabla Friendship).
  sentRequests     Friendship[] @relation("SentRequests")
  receivedRequests Friendship[] @relation("ReceivedRequests")

  // Mensajería.
  conversations    ConversationParticipant[]
  messages         Message[]
  messageReactions MessageReaction[]         @relation("MessageReactions")

  // Red social (estilo Tuenti).
  posts    Post[]
  comments Comment[]
  likes    Like[]
  stories  Story[]

  // Novedades: visitas a perfil y notificaciones.
  viewsMade     ProfileView[]  @relation("ViewsMade")
  viewsReceived ProfileView[]  @relation("ViewsReceived")
  notifications Notification[] @relation("NotificationsReceived")
  actions       Notification[] @relation("NotificationsActed")

  // Eventos.
  eventsHosted Event[]      @relation("EventsHosted")
  attendances  Attendance[] @relation("Attendances")

  // Fotos y álbumes.
  albums    Album[]    @relation("AlbumsOwned")
  photos    Photo[]    @relation("PhotosOwned")
  photoTags PhotoTag[] @relation("PhotoTags")

  @@map("users")
}

// ---------------------------------------------------------------------------
// Amistad / contacto entre dos usuarios.
// status: "PENDING" (solicitud enviada) | "ACCEPTED" (ya son amigos).
// Una fila representa la relación; el "requester" la inició.
// ---------------------------------------------------------------------------
model Friendship {
  id          String   @id @default(uuid())
  requesterId String
  addresseeId String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester User @relation("SentRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("ReceivedRequests", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
  @@map("friendships")
}

// ---------------------------------------------------------------------------
// Conversación (1-a-1 por ahora; el modelo soporta grupos en el futuro).
// ---------------------------------------------------------------------------
model Conversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String   @id @default(uuid())
  conversationId String
  userId         String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  attachmentUrl  String?
  replyToId      String?
  createdAt      DateTime  @default(now())
  readAt         DateTime?

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?          @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]         @relation("MessageReplies")
  reactions    MessageReaction[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

// Reacción a un mensaje (un emoji por usuario y mensaje, estilo Messenger).
model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation("MessageReactions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@map("message_reactions")
}

// ===========================================================================
// Red social estilo Tuenti: publicaciones (muro/feed), comentarios, "me gusta"
// y stories efímeras.
// ===========================================================================
model Post {
  id         String   @id @default(uuid())
  authorId   String
  content    String
  imageUrl   String?
  visibility String   @default("friends") // public | friends | private
  createdAt  DateTime @default(now())

  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]
  likes    Like[]

  @@index([authorId, createdAt])
  @@map("posts")
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("comments")
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  type      String   @default("like") // like | love | haha | wow | sad | angry
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("likes")
}

model Story {
  id        String   @id @default(uuid())
  authorId  String
  imageUrl  String
  createdAt DateTime @default(now())
  expiresAt DateTime

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@map("stories")
}

// ---------------------------------------------------------------------------
// Visitas a perfil (una fila por visitante; se actualiza la fecha).
// ---------------------------------------------------------------------------
model ProfileView {
  id        String   @id @default(uuid())
  viewerId  String
  profileId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  viewer  User @relation("ViewsMade", fields: [viewerId], references: [id], onDelete: Cascade)
  profile User @relation("ViewsReceived", fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([viewerId, profileId])
  @@index([profileId])
  @@map("profile_views")
}

// ---------------------------------------------------------------------------
// Notificaciones para el panel de "Novedades".
// type: like | comment | friend_request | friend_accept
// ---------------------------------------------------------------------------
model Notification {
  id        String   @id @default(uuid())
  userId    String
  actorId   String
  type      String
  postId    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User @relation("NotificationsReceived", fields: [userId], references: [id], onDelete: Cascade)
  actor User @relation("NotificationsActed", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Eventos (estilo Tuenti): un anfitrión crea un evento y la gente confirma.
// ---------------------------------------------------------------------------
model Event {
  id          String   @id @default(uuid())
  hostId      String
  title       String
  description String?
  location    String?
  imageUrl    String?
  startsAt    DateTime
  createdAt   DateTime @default(now())

  host        User         @relation("EventsHosted", fields: [hostId], references: [id], onDelete: Cascade)
  attendances Attendance[]

  @@index([startsAt])
  @@map("events")
}

model Attendance {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  status    String   @default("going") // going | maybe | declined
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation("Attendances", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("attendances")
}

// ===========================================================================
// Fotos, álbumes y etiquetas (estilo Facebook).
// ===========================================================================
model Album {
  id          String   @id @default(uuid())
  ownerId     String
  title       String
  description String?
  createdAt   DateTime @default(now())

  owner  User    @relation("AlbumsOwned", fields: [ownerId], references: [id], onDelete: Cascade)
  photos Photo[]

  @@index([ownerId])
  @@map("albums")
}

model Photo {
  id        String   @id @default(uuid())
  albumId   String?
  ownerId   String
  url       String
  caption   String?
  createdAt DateTime @default(now())

  album Album?     @relation(fields: [albumId], references: [id], onDelete: Cascade)
  owner User       @relation("PhotosOwned", fields: [ownerId], references: [id], onDelete: Cascade)
  tags  PhotoTag[]

  @@index([albumId])
  @@map("photos")
}

// Etiqueta de una persona en una foto, con su posición (x,y en %).
model PhotoTag {
  id        String   @id @default(uuid())
  photoId   String
  userId    String // persona etiquetada
  taggerId  String // quién etiquetó
  x         Float? // 0-100
  y         Float? // 0-100
  createdAt DateTime @default(now())

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  user  User  @relation("PhotoTags", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([photoId, userId])
  @@index([photoId])
  @@map("photo_tags")
}
