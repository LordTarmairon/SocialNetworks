# Copia este archivo a `.env` y rellena los valores.

# Base de datos PostgreSQL.
# En desarrollo se obtiene al ejecutar: npx prisma dev --name socialnetwork
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Autenticación
JWT_SECRET="genera-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"

# Servidor
PORT=3000
